# --- Server ---
NODE_ENV=development
PORT=4000

# --- Database ---
# MySQL 8. The URL password must be percent-encoded, so `@` becomes `%40`.
DATABASE_URL="mysql://root:your_password_here@127.0.0.1:3306/pglife"

# --- Auth ---
# Must be at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="replace_me_with_a_long_random_secret_at_least_32_chars"
COOKIE_NAME=pglife_token

# --- CORS ---
# Comma-separated list of frontend origins allowed to send credentialed requests.
CORS_ORIGINS=http://localhost:3000
